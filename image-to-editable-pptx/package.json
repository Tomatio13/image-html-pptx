{
  "name": "image-to-editable-pptx-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Skill tooling for reconstructing slide images as editable PowerPoint decks",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
